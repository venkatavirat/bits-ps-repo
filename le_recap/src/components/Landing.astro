---
import rect from '../assets/Rectangle22.svg';
import play from '../assets/nonoiseplay.svg';
import background from '../assets/table cats.gif';
import { PaperDeck } from './PaperDeck';

const defaultCards = [
  {
    id: 'loading-fallback',
    content: [
      'GENERATING YOUR RECAP...',
      '------------------------',
      'Connecting to Groq AI...',
      'Analyzing focus metrics...',
      'Preparing your stats!'
    ]
  }
];
---

<div id="container">
    
    <div class="screen-wipe"></div>

    <main id="landing-screen">
        <img id="background" src={background.src} alt="" fetchpriority="high" />
        <div class="rect" style={`--bg-url: url(${rect.src})`}>
            <h1 class="title">ReadWrap</h1>
            <button class="play-btn" id="start-button" aria-label="Play Game">
                <img class="play" src={play.src} alt=""/>
            </button>
        </div>
        <a class="credits" href="https://mejwh.tumblr.com">Background Credit: MEJWH</a>
    </main>

    <section id="game-screen">
        <PaperDeck cards={defaultCards} client:load />
    </section>
</div>

<script>
    const startButton = document.getElementById('start-button');
    const container = document.getElementById('container');
    const wipe = document.querySelector('.screen-wipe') as HTMLElement | null;

    startButton?.addEventListener('click', async () => {
        if (!container || !wipe) return;

        // 1. Trigger green screen wipe
        wipe.style.transformOrigin = 'left';
        container.classList.add('swipe-active');

        try {
            console.log('Fetching Groq recap cards...');
            
            // 2. Fetch the dynamic recap from Groq
            const response = await fetch('/api/generator', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    userData: {
                      role: "Software Engineering Intern",
                      company: "Caarya Innovative Pvt. Ltd.",
                      hoursLogged: 160,
                      topTopics: ["Astro Islands", "Groq AI Integration", "Framer Motion", "Student Wrapped Agent"],
                      accomplishment: "Built AI Portfolio Copilot & ReadWrap interactive app"
                    }
                })
            });

            if (!response.ok) {
              const errText = await response.text();
              throw new Error(`API returned ${response.status}: ${errText}`);
            }

            const cards = await response.json();
            console.log('Received cards from Groq:', cards);

            // 3. Dispatch generated cards to React PaperDeck component
            if (Array.isArray(cards) && cards.length > 0) {
                window.dispatchEvent(new CustomEvent('update-recap-cards', { detail: cards }));
            } else {
                console.warn('Groq returned empty card array:', cards);
            }
        } catch (e) {
            console.error('Failed to load dynamic Groq cards, using default fallback:', e);
        } finally {
            // 4. Complete transition once fetch finishes (or fails)
            setTimeout(() => {
                container.classList.add('wipe-complete'); 
                wipe.style.transformOrigin = 'right';      
                container.classList.remove('swipe-active'); 
            }, 300); // Small smooth buffer for the wipe to complete
        }
    });

    // Handle Back Transition
    window.addEventListener('go-back-to-landing', () => {
        if (!container || !wipe) return;

        wipe.style.transformOrigin = 'right';
        container.classList.add('swipe-active');

        setTimeout(() => {
            container.classList.remove('wipe-complete');
            wipe.style.transformOrigin = 'left';      
            container.classList.remove('swipe-active');
        }, 600);
    });
</script>

<style>
    /* ... keep your existing style section unchanged ... */
    #landing-screen, #game-screen {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
    }

    #landing-screen {
        padding-top: 2.5cqw; 
        z-index: 2;
        transition: opacity 0.4s ease;
    }

    #game-screen {
        background: hsl(180, 14%, 31%); /* Typo fixed: added % signs for valid CSS rendering */
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        pointer-events: none;
        z-index: 1;
    }

    .screen-wipe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: #09BC98;
        z-index: 10;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.6s cubic-bezier(0.77, 0, 0.175, 1);
    }

    .swipe-active .screen-wipe {
        transform: scaleX(1);
    }

    .wipe-complete #landing-screen {
        opacity: 0;
        pointer-events: none;
    }

    .wipe-complete #game-screen {
        opacity: 1;
        pointer-events: auto;
        z-index: 3;
    }

    :global(body) {
        margin: 0;
        padding: 0;
        overflow: hidden;
    }

    #container {
        container-type: size; 
        position: relative;
        width: 100vw;
        height: 100vh;
    }

    #background {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: -1;
    }

    main {
        margin: 0;
        position: absolute;
        top: 0;
        left: 0;
        padding-top: 2.5cqw;
    }

    .credits {
        position: fixed;
        bottom: 10px;
        right: 10px;
        font-family: 'Press Start 2P', cursive;
        color: rgba(212, 198, 70, 0.514);
        font-size: 0.6vw;
    }

    .rect {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background-image: url('../assets/Rectangle22.svg'); 
        background-repeat: no-repeat;
        background-size: cover;
        background-position: top;
        margin-left: 0px;
        padding: 4cqw 8cqw 4cqw 6cqw; 
        gap: 3cqw;
        width: fit-content;
        filter: drop-shadow(0px 0.8cqw 0px rgba(0, 0, 0, 0.15));
        animation: slideIn 1.2s cubic-bezier(0.25, 1, 0.5, 1) 0.2s forwards;
        opacity: 0;
        will-change: transform, opacity; 
    }

    .title {
        margin: 0;
        font-family: 'Press Start 2P', cursive;
        font-size: 4.5cqw; 
        line-height: 1;
        color: white;
        white-space: nowrap;
        text-shadow:
            -0.08em -0.08em 0 #09BC98,  0.08em -0.08em 0 #09BC98,
            -0.08em  0.08em 0 #09BC98,  0.08em  0.08em 0 #09BC98,
             0.15em  0.18em 0 #F2D857;
        animation: slideIn 1.2s cubic-bezier(0.25, 1, 0.5, 1) 0.2s forwards;
        opacity: 0;
        will-change: transform, opacity; 
    }

    .play-btn {
        background: none;
        border: none;
        padding: 0;
        margin: 0;
        cursor: pointer;
        outline: none;
        display: inline-flex;
        align-items: center;
        flex-shrink: 0;
        animation: slideIn 1.2s cubic-bezier(0.25, 1, 0.5, 1) 0.2s forwards;
        opacity: 0;
        will-change: transform, opacity; 
    }

    .play {
        height: 5cqw; 
        width: auto;
        transform: translateY(0.2cqw); 
        transition: transform 0.2s cubic-bezier(0.25, 1, 0.5, 1);
        image-rendering: pixelated; 
    }

    .play-btn:hover .play {
        transform: translateY(0.2cqw) scale(1.15);
    }

    .play-btn:active .play {
        transform: translateY(0.2cqw) scale(0.95);
    }

    @keyframes slideIn {
        from {
            transform: translateX(-100%);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }
</style>
